<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.superyoudi.businessservice.mapper.StudentCourseProgressMapper">

    <select id="selectProgressByStudentAndCourseIds"
            resultType="com.superyoudi.businessservice.pojo.entity.StudentCourseProgress">
        SELECT *
        FROM student_course_progresses
        WHERE student_id = #{userId}
        AND course_id IN
        <foreach collection="relateCourseIds" open="(" separator="," close=")" item="cid">
            #{cid}
        </foreach>


    </select>
</mapper>